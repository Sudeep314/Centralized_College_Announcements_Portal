# ==========================================
# CampusNotice Environment Configuration
# ==========================================

# Server Port
PORT=5000

# MongoDB Connection String (Local instance or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/campusnotice

# JWT Secret for signing Admin authorization tokens
JWT_SECRET=campusnotice_skill_lab_jwt_secret_key_2026_super_secure

# Administrator Credentials (for local Skill Lab demo)
ADMIN_USERNAME=admin
# Pre-computed bcrypt hash of "Admin@123"
ADMIN_PASSWORD_HASH=$2a$10$Rd6drI3mBz7KwMefIuLMheheGD.8oa5TiYGGszJnkhhD6M3k0Ywji

# Allowed Frontend Client Origin for CORS (e.g. Live Server on port 5500)
CLIENT_ORIGIN=http://localhost:5500
